# ---------------------------------------------------------------------------
# Area11 - environment example
# ---------------------------------------------------------------------------
# Is file ki copy bana kar ".env" naam rakhein (agar .env maujood na ho).
#   cp .env.example .env
#
# NOTE: ".env" me sirf LOCAL cheezein hain (database ka path) -- koi secret nahi.
# Secrets (Supabase keys wagera) ".env.local" me rakhein -- woh git me nahi jati.
# ---------------------------------------------------------------------------

# SQLite database file (path schema file se relative hai)
DATABASE_URL="file:../data/area11.db"

# Pehli baar bane owner ka default password/PIN (Phase 1 ke login se pehle badal lein)
OWNER_DEFAULT_PASSWORD="area11"
OWNER_DEFAULT_PIN="1111"
